# 服务环境。
NODE_ENV=development
# HTTP 监听端口。
PORT=3100
# 可选 HTTP 监听主机。本地联合开发由启动器传入 127.0.0.1。
#HOST=127.0.0.1
# API 根路径与 OpenAPI 文档入口路径。
API_PREFIX=/api
OPENAPI_URL=/openapi
# 浏览器访问入口，必须与 Logto 回调登记一致。
APP_ORIGIN=http://localhost:1282
# 当前服务器 PostgreSQL：主机 127.0.0.1，端口 15432，用户名 porthole_db_user。
# 数据库名和密码留空，由新项目填写；不能直接使用空库名 URL，驱动可能回退到默认库。
# 填写格式：postgresql://porthole_db_user:<密码>@127.0.0.1:15432/<本项目数据库名>
DATABASE_URL=
# 当前服务器 Redis：主机 127.0.0.1，端口 6379，使用密码认证。
# 填写本项目逻辑库编号和密码，避免所有新项目默认使用同一个逻辑库。
# 填写格式：redis://default:<密码>@127.0.0.1:6379/<本项目逻辑库编号>
REDIS_URL=
# 可选迁移专用连接，不配置时使用 DATABASE_URL。
#MIGRATION_DATABASE_URL=
# 认证模式：off、logto 或 local。更改后重启。
AUTH_MODE=off
# Logto Traditional Web 应用；回调 APP_ORIGIN + API_PREFIX + /auth/callback/logto。
# 示例地址 https://auth.example.com，仅 logto 模式需要填写。
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# API Resource 的 audience 与必要 scope。
LOGTO_API_RESOURCE=
LOGTO_API_SCOPE=api
# 生产 Logto 认证需要 Webhook 的签名密钥。
LOGTO_WEBHOOK_SIGNING_KEY=
# 自托管 Logto 的角色分配同步使用同实例的 Logto 数据库名。
LOGTO_ROLE_CHANGE_DATABASE=
# 登录事务与会话有效期，单位秒。
AUTH_LOGIN_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=2592000
# 可选日志目录、请求日志位图和幂等保留时长。
LOG_FILE_DIR=logs
IDEMPOTENCY_TTL_MS=86400000

# 生产默认使用 dev.preyou.site。开发默认使用 APP_ORIGIN 的主机名。
PORTHOLE_SHARE_DOMAIN=
# 回环监听。显式填写时优先于 HOST。
PORTHOLE_BIND_HOST=127.0.0.1
