# 应用名称，用于页面标题和应用级展示。
APP_NAME = 'Porthole'

# 开发服务器监听主机与端口。未填写时沿用 Vite 默认监听和端口 1282。
DEV_WEB_HOST =
DEV_WEB_PORT = 1282

# 本次开发代理的目标。留空时使用 API_ORIGIN，联合启动器可显式覆盖。
DEV_API_ORIGIN =

# 开发与正式运行的 API 代理目标。Caddy 从进程环境读取此项。
API_ORIGIN = 'http://127.0.0.1:3100'

# Caddy 站点地址。正式部署时从进程环境提供实际域名。
WEB_SITE = 'http://localhost:1282'

# 默认系统 API 基础地址。
VITE_SYS_API_BASE_URL = '/api'

# 默认系统 API 请求超时时间，单位毫秒。
VITE_SYS_API_TIMEOUT = 300000

# 全局通知的默认展示位置：top-left、top-center、top-right、bottom-left、bottom-center 或 bottom-right。
VITE_TOAST_POSITION = 'top-right'

# 全局通知的默认自动关闭时间，单位毫秒。
VITE_TOAST_DURATION_MS = 4000

# 全局加载条的定位方式：fixed 或 absolute。
VITE_LOADING_BAR_POSITION = 'fixed'

# 全局加载条显示前的延迟，单位毫秒。
VITE_LOADING_BAR_DELAY_MS = 120

# 全局加载条自动走到 95% 的预期时长，单位毫秒。
VITE_LOADING_BAR_DURATION_MS = 3000

# 全局加载条进入结束态并走到 100% 的时长，单位毫秒。
VITE_LOADING_BAR_SETTLE_DURATION_MS = 300

# OpenAPI 类型生成使用的 schema URL 或本地文件路径，由具体应用配置。
OPENAPI_INPUT = ''

# 评审标注项目标识，独立业务项目应设置为自己的唯一名称。
ANNOTATIONS_PROJECT_ID=ngt-starter

# 评审包中的后端地址，由项目填写浏览器可访问的地址。留空时使用本机开发地址。
ANNOTATIONS_SERVER_URL=

# 可选不可变评审构建 ID，留空时每次生成新 UUID。
ANNOTATIONS_BUILD_ID=
