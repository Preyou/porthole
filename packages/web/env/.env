APP_NAME = 'Porthole'

VITE_SYS_API_BASE_URL = '/api'
VITE_SYS_API_TIMEOUT = 300000

# 全局通知的默认展示位置。
VITE_TOAST_POSITION = 'top-right'

# 全局通知的默认自动关闭时间，单位毫秒。
VITE_TOAST_DURATION_MS = 4000

# 全局加载条的定位方式。
VITE_LOADING_BAR_POSITION = 'fixed'

# 全局加载条显示前的延迟，单位毫秒。
VITE_LOADING_BAR_DELAY_MS = 120

# 全局加载条自动走到 95% 的预期时长，单位毫秒。
VITE_LOADING_BAR_DURATION_MS = 3000

# 全局加载条进入结束态并走到 100% 的时长，单位毫秒。
VITE_LOADING_BAR_SETTLE_DURATION_MS = 300

# OpenAPI 类型生成使用的 schema URL 或本地文件路径。
OPENAPI_INPUT = './src/api/openapi.json'
